{
  "name": "@atlas/plugin-testkit",
  "description": "Plugin conformance harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "devDependencies": {
    "@atlas/tsconfig": "workspace:*"
  },
  "dependencies": {
    "@atlas/plugin-sdk": "workspace:*",
    "@atlas/hooks": "workspace:*",
    "@atlas/db": "workspace:*",
    "@testcontainers/postgresql": "^11.11.0",
    "zod": "^4.3.6"
  }
}
