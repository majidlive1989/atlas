{
  "name": "@atlas/plugin-sdk",
  "description": "Public plugin registration and service interfaces",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts",
    "test:api": "api-extractor run",
    "hooks:reference": "node scripts/hooks-reference.mjs",
    "registry:schema": "node scripts/registry-schema.mjs"
  },
  "devDependencies": {
    "@atlas/tsconfig": "workspace:*",
    "@types/semver": "^7.7.1",
    "@microsoft/api-extractor": "^7.58.0"
  },
  "dependencies": {
    "@atlas/contracts": "workspace:*",
    "@atlas/hooks": "workspace:*",
    "semver": "^7.7.3",
    "zod": "^4.3.6"
  }
}
