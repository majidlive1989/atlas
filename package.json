{
  "name": "atlas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "node scripts/check-workspaces.mjs && eslint . && prettier --check . && turbo run lint",
    "typecheck": "tsc -p tsconfig.json && turbo run typecheck",
    "test": "vitest run && turbo run test",
    "test:integration": "node scripts/check-services.mjs",
    "test:e2e": "playwright test",
    "services:up": "docker compose up --wait --wait-timeout 120",
    "services:down": "docker compose down",
    "format": "prettier --write .",
    "dev": "turbo run dev --filter=\"./apps/*\"",
    "changeset": "changeset",
    "prepare": "husky"
  },
  "devDependencies": {
    "@atlas/eslint-config": "workspace:*",
    "@atlas/prettier-config": "workspace:*",
    "@atlas/tsconfig": "workspace:*",
    "@changesets/cli": "^2.29.8",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "turbo": "^2.6.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx,cts,mts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yaml,yml,css,html}": "prettier --write"
  }
}
