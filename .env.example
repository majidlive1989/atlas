# Local development only. Configure real secrets outside this file for deployments.
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas-local
POSTGRES_DB=atlas
POSTGRES_PORT=5432
REDIS_PORT=6379
SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
MINIO_ROOT_USER=atlas-local
MINIO_ROOT_PASSWORD=atlas-local-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Phase 1 API and operator setup.
DATABASE_URL=postgresql://atlas:atlas-local@127.0.0.1:5432/atlas
ATLAS_AUTH_SECRET=
ATLAS_SITE_HOST=localhost
ATLAS_ISSUER=http://localhost:3000
ATLAS_ALLOWED_ORIGINS=http://localhost:5173
ATLAS_MAIL_URL=smtp://127.0.0.1:1025
ATLAS_MAIL_FROM=atlas@localhost.test
ATLAS_SEED_EMAIL=admin@example.test
ATLAS_SEED_PASSWORD=
ATLAS_TRUSTED_PLUGINS=phase-one-example

# Phase 2 plugin adapters
ATLAS_PLUGIN_STORAGE=.atlas-plugin-storage
