{
  "name": "@atlas/api",
  "description": "Fastify API composition root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts",
    "dev": "node --watch dist/main.js",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@atlas/tsconfig": "workspace:*",
    "@testcontainers/postgresql": "^11.12.0",
    "@apidevtools/swagger-parser": "^12.1.0",
    "testcontainers": "^11.14.0"
  },
  "dependencies": {
    "@atlas/kernel": "workspace:*",
    "@atlas/config": "workspace:*",
    "@atlas/auth": "workspace:*",
    "@atlas/db": "workspace:*",
    "@atlas/contracts": "workspace:*",
    "fastify": "^5.6.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/cookie": "^11.0.2",
    "fastify-type-provider-zod": "^6.1.0",
    "zod": "^4.1.12"
  }
}
