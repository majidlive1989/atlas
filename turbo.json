{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "packages/tsconfig/index.json",
    "packages/eslint-config/index.mjs",
    "packages/prettier-config/index.mjs",
    "eslint.config.mjs",
    "prettier.config.mjs",
    "vitest.config.ts"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
